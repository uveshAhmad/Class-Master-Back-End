{
    "version": 2,
    "builds": [
      {
        "src": "server.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "headers":{
          "Access-Control-Allow-Origin":"https://class-master-frontend-mtg7.vercel.app",
          "Access-Control-Allow-Methods":"GET POST PATCH DELETE OPTIONS",
          "Access-Control-Allow-Headers" : "Content-Type, Authorization"

        },
        "dest": "server.js"
      }
    ]
  }
  